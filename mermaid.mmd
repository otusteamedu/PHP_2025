erDiagram
    movie ||--o{ attribute_values : "has values"
    attribute_type ||--|{ attribute : "groups"
    attribute ||--o{ attribute_values : "describes"

    movie {
        serial id PK
        varchar(255) title "NOT NULL"
        int duration "NOT NULL"
        text description
    }

    attribute_type {
        serial id PK
        varchar(255) name "NOT NULL UNIQUE"
        enum data_type "varchar|text|int|decimal|boolean|date|json"
    }

    attribute {
        serial id PK
        int attr_type_id FK "REFERENCES attribute_type(id)"
        varchar(100) name "NOT NULL UNIQUE"
        text description
    }

    attribute_values {
        serial id PK
        int movie_id FK "REFERENCES movie(id)"
        int attribute_id FK "REFERENCES attribute(id)"
        varchar(255) value_varchar
        text value_text
        int value_int
        decimal value_decimal "decimal(10,2)"
        boolean value_boolean
        date value_date
        json value_json
    }
