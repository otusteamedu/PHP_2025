{
    "name": "otus/otus",
    "description": "otus-php-2025",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "phexel",
            "role": "developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-memcached": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "league/container": "^5.1",
        "league/route": "^6.2",
        "middlewares/content-length": "^2.1",
        "middlewares/http-authentication": "^2.2",
        "middlewares/payload": "^3.1",
        "symfony/dotenv": "^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Otus\\": "src/"
        }
    },
    "scripts": {
        "rector": "vendor/bin/rector",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fixer"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
