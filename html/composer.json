{
    "name": "otus/food",
    "type": "project",
    "require": {
        "php": "^8.4.0",
        "friendsofphp/php-cs-fixer": "^3.93",
        "rector/rector": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Otus\\Food\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Otus\\Food\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alexander",
            "email": "system.bin@yandex.ru"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "test": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fixer"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
