{
    "name": "otus/otus",
    "description": "otus-php-2025",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "phexel",
            "role": "developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-memcached": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Otus\\": "src/"
        }
    },
    "scripts": {
        "rector": "vendor/bin/rector",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fixer"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
