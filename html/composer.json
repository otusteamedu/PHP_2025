{
    "name": "otus/data-mapper",
    "type": "project",
    "require": {
        "php": ">=8.4.0",
        "ext-pdo": "*",
        "ext-reflection": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "rector/rector": "^2.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Otus\\DataMapper\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Alexander",
            "email": "system.bin@yandex.ru"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "rector": "vendor/bin/rector",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "fix": [
            "@rector",
            "@php-cs-fixer"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
