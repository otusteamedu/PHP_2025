# === Приложение ===
APP_NAME=mkd-bot
APP_DOMAIN=mkd-bot.digsol.ru
APP_ENV=development
APP_DEBUG=true

# Только для Dev
WWW_ROOT_DIR=./code

# === БД Postgres ===
PG_HOST=postgres
PG_PORT=5432
PG_DB=mkd_bot
PG_USER=mkd_user
PG_PASSWORD=topSecret123

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_LOGIN=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_TELEGRAM_FORWARD=mkd.telegram.forward
RABBITMQ_QUEUE_RAG_QUERY=mkd.rag.query
RABBITMQ_QUEUE_FALLBACK=mkd.fallback

