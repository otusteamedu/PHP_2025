HTTP_PORT=8080
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ------------------------------------------------------------------------------
# Database (used by PHP application)
# ------------------------------------------------------------------------------

DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=my_api
DB_USER=my_api_app
DB_PASSWORD=your_secure_password

# ------------------------------------------------------------------------------
# PostgreSQL container initialization
# ------------------------------------------------------------------------------

POSTGRES_DB=invest_portfolio
POSTGRES_USER=invest_portfolio_app
POSTGRES_PASSWORD=your_secure_password

POSTGRES_EXTERNAL_PORT=5436