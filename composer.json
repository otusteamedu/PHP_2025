{
    "name": "arlex2305k/emails-verifier",
    "type": "project",
    "autoload": {
        "psr-4": {
            "EmailsVerifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EmailsVerifier\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    }
}
