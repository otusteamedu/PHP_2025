{
    "name": "alex/hw17",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": "^8.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "mockery/mockery": "^1.6",
        "php-mock/php-mock-mockery": "^1.5"
    },
    "scripts": {
        "test": ["vendor/bin/phpunit"],
        "test:coverage": ["php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html coverage"]
    }
}
