{
    "name": "customer41/php-learning",
    "description": "This project is designed to learn php at OTUS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-memcached": "*",
        "ext-intl": "*",
        "ext-pcntl": "*",
        "vlucas/phpdotenv": "^5.6",
        "customer41/multiexception": "^1.0",
        "elasticsearch/elasticsearch": "^9.3",
        "symfony/console": "^8.0",
        "php-amqplib/php-amqplib": "^3.7",
        "symfony/mailer": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UnitTests\\": "tests/unit",
            "IntegrationTests\\": "tests/integration"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
