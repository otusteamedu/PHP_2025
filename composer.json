{
    "name": "customer41/php-learning",
    "description": "This project is designed to learn php at OTUS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-memcached": "*",
        "ext-intl": "*",
        "vlucas/phpdotenv": "^5.6",
        "customer41/multiexception": "^1.0",
        "elasticsearch/elasticsearch": "^9.3",
        "symfony/console": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
