{
  "name": "asenishin/book-search",
  "description": "Консольное приложение для поиска книг в Elasticsearch",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "elasticsearch/elasticsearch": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
