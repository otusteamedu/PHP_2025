upstream php-fpm-backend {
    least_conn;
    server unix:/var/run/php/php-fpm-${INSTANCE_ID_1}.sock;
    server unix:/var/run/php/php-fpm-${INSTANCE_ID_2}.sock;
}
server {
    # указываем 80 порт для соединения
    listen 80;
    server_name _; 
    root /var/www/html/src/public;
    index index.php;

    # при обращении к статическим файлам логи не нужны, равно как и обращение к fpm
    location ~* \.(jpg|jpeg|gif|css|png|js|ico|html)$ {
        access_log off;
        expires max;
    }

    # помним про единую точку доступа
    # все запросы заворачиваются в корневую директорию root на index.php
    location / {
        try_files $uri /index.php$is_args$args;
    }

    # и наконец правило обращения к php-fpm через Unix-сокет
    location ~* \.php$ {
        try_files $uri = 404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php-fpm-backend;
        fastcgi_index index.php;
        # Важные параметры для Unix-сокета
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        include fastcgi_params;
        
        # Дополнительные настройки
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 300;
    }

    error_log /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
}