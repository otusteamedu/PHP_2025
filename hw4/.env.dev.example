# Основные настройки
APP_DIR=/data/application.local
APP_ENV=dev

# Docker
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1

# Веб-сервер
HTTP_PORT=8080
HTTPS_PORT=8443
SERVER_NAME=application.local

# Образы
NGINX_IMAGE=nginx:1.19-alpine
PHP_FPM_IMAGE=php:8.1.5-fpm-alpine
PHP_IDE_CONFIG=serverName=${SERVER_NAME}

# PostgreSQL
POSTGRES_DB=hw1_database
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=otus-password
POSTGRES_PORT=5432
POSTGRES_USER=otus-user
POSTGRES_VERSION=12.4-alpine

# Кэши
MEMCACHED_HOST=memcached
MEMCACHED_IMAGE=memcached:latest
MEMCACHED_PORT=11211
REDIS_HOST=redis
REDIS_IMAGE=redis:7.0.4-alpine
REDIS_PORT=6379

# Отладка
XDEBUG_MODE=debug
UID=1000
