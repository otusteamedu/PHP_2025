{
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "vsilkin",
      "email": "testemail@gmail.com"
    }
  ],
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-phpbrowser": "^4.0",
    "codeception/module-rest": "^3.4",
    "codeception/module-asserts": "^3.3",
    "codeception/module-symfony": "^3.8"
  },
  "require": {
    "vlucas/phpdotenv": "^5.6"
  },
  "scripts": {
    "run-unit": "codecept run unit",
    "run-unit-coverage": "XDEBUG_MODE=coverage codecept run unit --coverage"
  }
}
