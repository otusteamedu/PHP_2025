# -----------------------------
# RabbitMQ: доступ и порты
# -----------------------------
# Логин и пароль для контейнера RabbitMQ и PHP-приложения (producer/worker).
RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# Виртуальный хост RabbitMQ, который использует приложение.
RABBITMQ_VHOST=/

# Имя очереди для асинхронных задач.
RABBITMQ_QUEUE_NAME=task_queue

# Порты хоста, проброшенные из контейнера RabbitMQ.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -------------------------
# Redis: доступ и порты
# -------------------------
# Пароль Redis, используется контейнером и сервисом RequestStatusService.
REDIS_PASSWORD=change_me_redis_password

# Порт хоста, проброшенный из контейнера Redis.
REDIS_PORT=6379

# Индекс базы Redis и сетевой таймаут для PHP-сервисов.
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=2.5

# Префикс ключей и TTL (в секундах) для статусов запросов.
REQUEST_STATUS_KEY_PREFIX=request_status:
REQUEST_STATUS_TTL_SECONDS=604800