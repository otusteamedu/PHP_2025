APP_ENV=dev

NGINX_PUBLISHED_PORT=20101
DB_PUBLISHED_PORT=20102

POSTGRES_VERSION=17
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
POSTGRES_HOST=postgres

ELASTIC_USER=elastic
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_NODE_NAME=elasticsearch-node-1
ELASTIC_CA_BUNDLE=/path/to/ca.crt
ELASTIC_PASSWORD=123456
ELASTIC_HTTP_CERT_PASSWORD=123456
ELASTIC_TRANSPORT_CERT_PASSWORD=123456

SSH_PUBLIC_KEY="ssh-ed25519..."

REDIS_HOST=redis
REDIS_PORT=6379

MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

EVENT_STORAGE=redis
CACHE_STORAGE=redis

RABBITMQ_HOST=rabbitmq
RABBITMQ_PUBLISHED_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=rabbitmq_user
RABBITMQ_PASS=rabbitma_password

RABBITMQ_BANK_REPORTS_QUEUE=bank_reports
RABBITMQ_BANK_REPORTS_RETRY_TTL_SECONDS=30
RABBITMQ_BANK_REPORTS_MAX_ATTEMPTS=3
RABBITMQ_BANK_REPORTS_PREFETCH_COUNT=1

BANK_REPORTS_MAILER_FROM=reports@bank.local
BANK_REPORTS_MAILER_SIMULATION=ok

MAILER_DSN=smtp://mailpit:1025
MAILER_BASE_API_URL=http://mailpit:8025
