# === Приложение ===
APP_NAME=mkd-bot
APP_DOMAIN=bot.example.ru
APP_ENV=production
APP_DEBUG=false

# только для Dev
#WWW_ROOT_DIR=./code

# === БД Postgres ===
PG_HOST=postgres
PG_PORT=5432
PG_DB=mkd_bot
PG_USER=mkd_user
PG_PASSWORD=CHANGE_ME_1

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_LOGIN=guest
RABBITMQ_PASSWORD=CHANGE_ME_2
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_TELEGRAM_FORWARD=mkd.telegram.forward
RABBITMQ_QUEUE_RAG_QUERY=mkd.rag.query
RABBITMQ_QUEUE_FALLBACK=mkd.fallback

# === Max Bot ===
MAX_TOKEN=CHANGE_ME_3
MAX_CHANNEL=CHANGE_ME_4
MAX_WEBHOOK_SECRET=CHANGE_ME_5

# === Telegram Bot ===
TELEGRAM_TOKEN=CHANGE_ME_6
TELEGRAM_CHANNEL=CHANGE_ME_7
TELEGRAM_SECRET_TOKEN=CHANGE_ME_8
TELEGRAM_HTTP_PROXY=
TELEGRAM_PROXY_LOGIN=
TELEGRAM_PROXY_PASSWORD=
# режим работы с Telegram: longpoll/webhook
TELEGRAM_MODE=longpoll

# === Логирование: DEBUG/ERROR/INFO ===
LOG_LEVEL=INFO

# === SMTP для уведомлений о предложениях ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="МКД Бот"
PROPOSAL_NOTIFY_EMAILS=

# === E2E-тесты - только для Dev ===
#E2E_USE_INTERNAL_DNS=false

# === Switch-nginx - только для Prod ===
SWITCH_PORT=8080
